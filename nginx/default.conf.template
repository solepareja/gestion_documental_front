server {
    listen 8080;
    server_tokens off;
    client_max_body_size 36m;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;
    add_header Referrer-Policy "no-referrer" always;
    root /usr/share/nginx/html;
    location = /portal-health { access_log off; return 200 "ok\n"; }
    location = /api { return 308 /api/; }
    location /api/ {
        proxy_pass https://${API_HOST}/;
        proxy_set_header Host ${API_HOST};
        proxy_set_header CF-Access-Client-Id "${CF_ACCESS_CLIENT_ID}";
        proxy_set_header CF-Access-Client-Secret "${CF_ACCESS_CLIENT_SECRET}";
        proxy_set_header X-API-Key "${API_KEY_PORTAL}";
        proxy_set_header Cf-Access-Jwt-Assertion "";
        proxy_set_header X-Forwarded-For $http_cf_connecting_ip;
        proxy_set_header X-Forwarded-Proto https;
        proxy_ssl_server_name on;
        proxy_ssl_name ${API_HOST};
        proxy_ssl_verify on;
        proxy_ssl_trusted_certificate /etc/ssl/certs/ca-certificates.crt;
        proxy_ssl_verify_depth 3;
        proxy_connect_timeout 10s;
        proxy_read_timeout 130s;
        proxy_send_timeout 130s;
        proxy_next_upstream off;
        proxy_cache off;
    }
    location = /index.html { add_header Cache-Control "no-cache"; }
    location = /sw.js { add_header Cache-Control "no-cache"; try_files $uri =404; }
    location /assets/ { expires 1y; try_files $uri =404; }
    location ~ /\. { deny all; }
    location / { try_files $uri /index.html; }
}
